<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- consider, validate and test with maven wrapper
         already includes Spring Boot BOM
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
    </parent> -->

    <groupId>bm</groupId>
    <artifactId>bm-sim</artifactId>
    <version>1.2.0-RC</version>
    <packaging>pom</packaging>

    <name>== blue marble simulations                ===</name>
    <description>
        Super POM to compile, test and build ALL sources with dependencies.
        Root aggregate / Super POM for the blue marble repository.
    </description>
    <url>https://github.com/kbeigl/bm</url>

    <developers>
        <developer>
            <name>Kristof Beiglböck</name>
            <email>kbeigl@web.de</email>
            <url>https://github.com/kbeigl</url>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.html</url>
        </license>
    </licenses>

    <properties>
        <!-- os-maven-plugin-version>1.6.0</os-maven-plugin-version -->
        <!-- always generate new maven wrapper version! -->
        <!-- lower version for github and eclipes m2e -->
        
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- ${java.runtime.version} and requireJavaVersion -->
        <jdk.version>21</jdk.version>
        <!-- 'release' replaces source/target: sets system module location
             and avoids the javac "release 21 is recommended" warning -->
        <maven.compiler.release>${jdk.version}</maven.compiler.release>
        
        <maven-minimum-version>4.0.0-rc-7</maven-minimum-version>
        <!-- 4.0.0-beta-4/5 fail with "Duplicate key" on testCompile
             when an artifact is on both compile and test classpaths
             (e.g. camel-spring-boot-starter via traccar-api-client and
             gps-osmand-tracker in traccar-realtime-client).
             Use the latest stable 3.x until a fixed 4.x is released. -->
        <maven-compiler-plugin-version>3.16.0</maven-compiler-plugin-version>
        <maven-enforcer-plugin-version>3.6.3</maven-enforcer-plugin-version>

        <maven-clean-plugin-version>4.0.0-beta-3</maven-clean-plugin-version>
        <maven-install-plugin-version>4.0.0-beta-3</maven-install-plugin-version>
        <maven-deploy-plugin-version>4.0.0-beta-3</maven-deploy-plugin-version>
        <maven-dependency-plugin-version>3.11.0</maven-dependency-plugin-version>

        <!-- keep 3.x: m2e's embedded Maven 3.9 executes resources:resources in the
             workspace build and cannot load Maven 4 API plugins (4.0.0-beta-2) -->
        <maven-resources-plugin-version>3.5.0</maven-resources-plugin-version>
        <!-- 4.0.0-beta-2 fails with "duplicate entry META-INF/maven/.../pom.properties" -->
        <maven-jar-plugin-version>3.5.1</maven-jar-plugin-version>
        <maven-surefire-plugin-version>3.6.0</maven-surefire-plugin-version>
        <maven-failsafe-plugin-version>3.6.0</maven-failsafe-plugin-version>
        <!-- 4.0.0-beta-1 is incompatible with Maven 4.0.0-rc-7 API (NoSuchMethodError) -->
        <maven-source-plugin-version>3.4.0</maven-source-plugin-version>
        <maven-javadoc-plugin-version>3.12.0</maven-javadoc-plugin-version>
    </properties>

    <modules>
        <module>bm-parent</module>
        <module>bm-tracker</module>
        <module>bm-traccar</module>
        <module>bm-realtime-apps</module>
        <module>bm-docs</module>
    </modules>

    <build>
      <pluginManagement>
          <plugins>
              <plugin>
                  <groupId>org.apache.maven.plugins</groupId>
                  <artifactId>maven-clean-plugin</artifactId>
                  <version>${maven-clean-plugin-version}</version>
              </plugin>
              <plugin>
                  <groupId>org.apache.maven.plugins</groupId>
                  <artifactId>maven-install-plugin</artifactId>
                  <version>${maven-install-plugin-version}</version>
              </plugin>
              <plugin>
                  <groupId>org.apache.maven.plugins</groupId>
                  <artifactId>maven-deploy-plugin</artifactId>
                  <version>${maven-deploy-plugin-version}</version>
              </plugin>
              <plugin>
                  <groupId>org.apache.maven.plugins</groupId>
                  <artifactId>maven-resources-plugin</artifactId>
                  <version>${maven-resources-plugin-version}</version>
              </plugin>
              <plugin>
                  <groupId>org.apache.maven.plugins</groupId>
                  <artifactId>maven-compiler-plugin</artifactId>
                  <version>${maven-compiler-plugin-version}</version>
              </plugin>
              <plugin>
                  <groupId>org.apache.maven.plugins</groupId>
                  <artifactId>maven-jar-plugin</artifactId>
                  <version>${maven-jar-plugin-version}</version>
              </plugin>
          </plugins>
      </pluginManagement>

        <!-- 
        <extensions>
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>${os-maven-plugin-version}</version>
            </extension>
        </extensions>
        -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin-version}</version>
                <executions>
                    <execution>
                        <id>enforce-maven</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>${maven-minimum-version}</version>
                                </requireMavenVersion>
                                <!-- <requireJavaVersion> -->
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
