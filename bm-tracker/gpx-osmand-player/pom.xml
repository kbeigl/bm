<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>bm</groupId>
        <artifactId>bm-tracker</artifactId>
        <version>1.1.28</version>
    </parent>

    <artifactId>gpx-osmand-player</artifactId>

    <name>...... gpx-osmand-player</name>
    <description>standalone gpx-player Spring Boot application with Hawtio console</description>

    <dependencies>
        <!-- ========== bm libraries ========== -->
        <!-- gps-osmand-player brings gps-osmand-tracker, camel, file, quartz -->
        <dependency>
            <groupId>bm</groupId>
            <artifactId>gps-osmand-player</artifactId>
            <version>${project.parent.version}</version>
        </dependency>

        <!-- ========== Hawtio & Web Management ========== -->
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-management-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.hawt</groupId>
            <artifactId>hawtio-springboot</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- explicit resources override the Maven default,
                 so src/main/resources must be declared again -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>asciidoc</directory>
                <targetPath>asciidoc</targetPath>
                <includes>
                    <include>**/*</include>
                </includes>
                <excludes>
                    <exclude>**/*.html</exclude>
                    <exclude>**/*.svg.cache</exclude>
                    <exclude>**/.asciidoctor/**</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>bm.gps.player.PlayerApplication</mainClass>
                    <classifier>exec</classifier>
                    <!-- exec jar is renamed to gpx-player-<version>.jar below,
                         so it must not be attached for install/deploy -->
                    <attach>false</attach>
                </configuration>
            </plugin>
            <plugin>
                <!-- spring-boot:repackage always names the jar after the artifact,
                     so rename the executable jar to gpx-player-<version>.jar -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>rename-exec-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <move
                                    file="${project.build.directory}/${project.build.finalName}-exec.jar"
                                    tofile="${project.build.directory}/gpx-player-${project.version}.jar" />
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
