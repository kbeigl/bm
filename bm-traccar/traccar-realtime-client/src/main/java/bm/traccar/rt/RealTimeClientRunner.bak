package bm.traccar.rt;

import bm.traccar.RealTimeClient;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.CommandLineRunner;
import org.springframework.core.env.Environment;
import org.springframework.stereotype.Component;

/**
 * Command line runner for RealTimeClient when used in standalone mode.
 *
 * <p>This runner automatically initializes the RealTimeClient and waits for shutdown when the
 * application is started. It skips execution in test context.
 */
@Component
@Deprecated
public class RealTimeClientRunner implements CommandLineRunner {

  @Autowired private RealTimeClient client;
  @Autowired private Environment environment;

  @Override
  public void run(String... args) throws Exception {
    // hook to skip run() in test context
    if (isTestContext()) return;

    // Initialize and wait for shutdown
    client.initialize();
    client.waitForShutdown();
  }

  /** used in test context to avoid blocking */
  private boolean isTestContext() {
    for (String profile : environment.getActiveProfiles()) {
      if ("test".equals(profile)) {
        return true;
      }
    }
    return false;
  }
}
